<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/echo_widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:text="ЭХО · СЕЙЧАС ИГРАЕТ"
        android:textColor="#64748B"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/widget_track"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ЭХО"
        android:textColor="#F2F5F7"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_artist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="включите музыку"
        android:textColor="#38BDF8"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_persona"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Ночной акустический атлас"
        android:textColor="#85909E"
        android:textSize="10sp"
        android:textStyle="italic" />
</LinearLayout>
